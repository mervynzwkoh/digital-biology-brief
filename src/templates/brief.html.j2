<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Biology Weekly Brief — {{ date }}</title>
    <meta name="description" content="Weekly digest of frontier research, events, and jobs in ML for drug discovery, protein design, and virtual cell modelling — {{ date }}">
    <style>
        :root {
            --bg-primary: #0d1117;
            --bg-secondary: #161b22;
            --bg-card: #1c2128;
            --border: #30363d;
            --text-primary: #e6edf3;
            --text-secondary: #8b949e;
            --text-muted: #6e7681;
            --accent-blue: #58a6ff;
            --accent-green: #3fb950;
            --accent-purple: #bc8cff;
            --accent-orange: #d29922;
            --accent-red: #f85149;
            --gradient-research: linear-gradient(135deg, #1a1b3a 0%, #162447 100%);
            --gradient-events: linear-gradient(135deg, #1a2e1a 0%, #16341a 100%);
            --gradient-jobs: linear-gradient(135deg, #2d1a1a 0%, #34231a 100%);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            padding: 0;
        }

        .container {
            max-width: 860px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }

        header {
            text-align: center;
            padding: 3rem 0 2rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 2.5rem;
        }

        header h1 {
            font-size: 1.8rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        header .date {
            font-size: 1.1rem;
            color: var(--text-secondary);
        }

        header .subtitle {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.5rem;
        }

        .section {
            margin-bottom: 3rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--border);
        }

        .section-header .icon {
            font-size: 1.5rem;
        }

        .section-header h2 {
            font-size: 1.4rem;
            font-weight: 600;
        }

        .section-header .count {
            font-size: 0.8rem;
            color: var(--text-muted);
            background: var(--bg-secondary);
            padding: 0.15rem 0.6rem;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .item {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1rem;
            transition: border-color 0.2s ease;
        }

        .item:hover {
            border-color: var(--accent-blue);
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
        }

        .item h3 {
            font-size: 1.05rem;
            font-weight: 600;
            line-height: 1.4;
            flex: 1;
        }

        .item h3 a {
            color: var(--accent-blue);
            text-decoration: none;
        }

        .item h3 a:hover {
            text-decoration: underline;
        }

        .item-meta {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
            margin-bottom: 0.75rem;
        }

        .tag {
            font-size: 0.75rem;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            color: var(--text-secondary);
            border: 1px solid var(--border);
        }

        .tag-source { color: var(--accent-purple); border-color: rgba(188, 140, 255, 0.3); }
        .tag-date { color: var(--text-muted); }

        .item-body h4 {
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-top: 0.75rem;
            margin-bottom: 0.3rem;
        }

        .item-body p {
            font-size: 0.92rem;
            color: var(--text-secondary);
            line-height: 1.65;
        }

        .item-body .caveats {
            font-style: italic;
            color: var(--accent-orange);
            font-size: 0.85rem;
        }

        /* Events & Jobs items — simpler layout */
        .item-simple {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 0.5rem;
            align-items: start;
        }

        .item-simple .details {
            font-size: 0.88rem;
            color: var(--text-secondary);
        }

        .item-simple .details span {
            display: inline-block;
            margin-right: 1rem;
        }

        .item-simple .relevance {
            font-size: 0.85rem;
            color: var(--accent-green);
            margin-top: 0.3rem;
        }

        footer {
            text-align: center;
            padding: 2rem 0;
            border-top: 1px solid var(--border);
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        footer a {
            color: var(--accent-blue);
            text-decoration: none;
        }

        .empty-section {
            color: var(--text-muted);
            font-style: italic;
            padding: 1rem 0;
        }

        @media (max-width: 640px) {
            .container { padding: 1rem; }
            header h1 { font-size: 1.4rem; }
            .item { padding: 1rem; }
            .item-simple { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🧬 Digital Biology Weekly Brief</h1>
            <div class="date">{{ date }}</div>
            <div class="subtitle">ML for drug discovery · Protein structure & design · Virtual cell modelling</div>
        </header>

        <!-- Research Section -->
        <section class="section">
            <div class="section-header">
                <span class="icon">🔬</span>
                <h2>Frontier Research</h2>
                <span class="count">{{ research_items|length }} items</span>
            </div>

            {% if research_items %}
            {% for item in research_items %}
            <div class="item">
                <div class="item-header">
                    <h3><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.headline or item.title }}</a></h3>
                </div>
                <div class="item-meta">
                    <span class="tag tag-source">{{ item.source_name }}</span>
                    {% if item.published_at %}<span class="tag tag-date">{{ item.published_at }}</span>{% endif %}
                </div>
                <div class="item-body">
                    {% if item.whats_new %}
                    <h4>What's New</h4>
                    <p>{{ item.whats_new }}</p>
                    {% endif %}

                    {% if item.technical_innovation %}
                    <h4>Technical Innovation</h4>
                    <p>{{ item.technical_innovation }}</p>
                    {% endif %}

                    {% if item.caveats %}
                    <h4>Caveats</h4>
                    <p class="caveats">{{ item.caveats }}</p>
                    {% endif %}
                </div>
            </div>
            {% endfor %}
            {% else %}
            <p class="empty-section">No research items this week.</p>
            {% endif %}
        </section>

        <!-- Events Section -->
        <section class="section">
            <div class="section-header">
                <span class="icon">📅</span>
                <h2>Events</h2>
                <span class="count">{{ events_items|length }} items</span>
            </div>

            {% if events_items %}
            {% for item in events_items %}
            <div class="item">
                <div class="item-simple">
                    <div>
                        <h3><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name or item.title }}</a></h3>
                        <div class="details">
                            {% if item.date %}<span>📆 {{ item.date }}</span>{% endif %}
                            {% if item.location %}<span>📍 {{ item.location }}</span>{% endif %}
                            {% if item.organizer_or_employer %}<span>🏢 {{ item.organizer_or_employer }}</span>{% endif %}
                        </div>
                        {% if item.relevance_note %}
                        <div class="relevance">→ {{ item.relevance_note }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
            {% else %}
            <p class="empty-section">No events this week.</p>
            {% endif %}
        </section>

        <!-- Jobs Section -->
        <section class="section">
            <div class="section-header">
                <span class="icon">💼</span>
                <h2>Jobs</h2>
                <span class="count">{{ jobs_items|length }} items</span>
            </div>

            {% if jobs_items %}
            {% for item in jobs_items %}
            <div class="item">
                <div class="item-simple">
                    <div>
                        <h3><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name or item.title }}</a></h3>
                        <div class="details">
                            {% if item.organizer_or_employer %}<span>🏢 {{ item.organizer_or_employer }}</span>{% endif %}
                            {% if item.location %}<span>📍 {{ item.location }}</span>{% endif %}
                            {% if item.date %}<span>📆 Posted: {{ item.date }}</span>{% endif %}
                        </div>
                        {% if item.relevance_note %}
                        <div class="relevance">→ {{ item.relevance_note }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
            {% else %}
            <p class="empty-section">No job listings this week.</p>
            {% endif %}
        </section>

        <footer>
            <p>Generated {{ generated_at }} · <a href="../index.html">← Archive</a></p>
            <p>Digital Biology Weekly Brief — automated with ❤️ and Claude Haiku</p>
        </footer>
    </div>
</body>
</html>
